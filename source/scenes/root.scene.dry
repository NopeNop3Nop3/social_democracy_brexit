// coups and capital strikes happen when you upset the right or the capitalists too much with your policies. they're an additional check on your policies, when purely electoral checks don't suffice.
// when coup_progress reaches 10 or capital_strike_progress reaches 10, there's a special event that launches the coup.
Q.coup_progress = 0;
Q.capital_strike_progress = 0;

Q.budget = 4;

// Proportion of different social groups
// source: https://durham-repository.worktribe.com/output/1443513/
Q.precariat = 15; // poorest and most deprived, tend not to socialise outside their class, have an overall low range of cultural interests and most rent homes in old industrial areas
Q.service_workers = 19; // financially insecure, have broad contacts with other classes, enjoy emerging culture like gigs, sports and social media, and live in inexpensive urban cities
Q.traditional_workers = 14; // have some financial security, tend not to socialise outside their class, tend not to enjoy emerging culture like gigs, sports and social media, usually own their homes
Q.affluent_workers = 15; // financially secure but not well-off, usually have a working class background, strongly enjoy emerging culture but dislike highbrow culture like music and theatre, tend to live in the old industrial areas
Q.technical_middle = 6; //  prosperous, tend to mix with their own class and have middle class backgrounds, somewhat prefer emerging culture to highbrow culture, tend to live in suburban areas like the south east
Q.established_middle = 25; // second most wealthy, socialise with a broad range of classes and have middle class backgrounds, enjoy a wide range of culture, often live outside urban areas
Q.elites = 6; // wealthies and most privilleged, have a wide range of contacts but their background is privilleged, have a high enjoyment of all culture, most own their own houses in london or the home counties

// income for industrial workers in reichsmarks/year - 1928 = 1600 Reichsmarks/year; 1931 = 1440 Reichsmarks/year; 1933 = 1138 Reichsmarks/year - source: https://babel.hathitrust.org/cgi/pt?id=uiug.30112104147985&seq=50
